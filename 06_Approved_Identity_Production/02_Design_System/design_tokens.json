{
  "$schema": "https://tr.designtokens.org/format/",
  "brand": {
    "name": "AETHRA",
    "tagline": "From the unseen to the extraordinary.",
    "positioning": "Custom Software Engineering & Digital Technology Partner",
    "visual_direction": "Light-first architectural lavender/white surfaces, geometric violet A monogram, deep-ink typography"
  },
  "color": {
    "violet-primary": {
      "value": "#7446F5",
      "rgb": "116, 70, 245",
      "role": "Primary brand mark, key accents, interactive focus"
    },
    "violet-deep": {
      "value": "#5D2BE7",
      "rgb": "93, 43, 231",
      "role": "Accessible text/buttons on light surfaces (WCAG AA 5.71:1), right-leg gradient anchor"
    },
    "violet-soft": {
      "value": "#B18CFE",
      "rgb": "177, 140, 254",
      "role": "Lower-left monogram gradient stop, subtle dark-mode highlights"
    },
    "lavender-tint": {
      "value": "#F2EDFF",
      "rgb": "242, 237, 255",
      "role": "Secondary light surface, section backgrounds, geometric planes"
    },
    "lavender-plane": {
      "value": "#EAE0FF",
      "rgb": "234, 224, 255",
      "role": "Intersecting diagonal architectural background planes"
    },
    "lavender-border": {
      "value": "#E2D9FA",
      "rgb": "226, 217, 250",
      "role": "1px structural grid lines and card borders on light surfaces"
    },
    "surface": {
      "value": "#FCFBFF",
      "rgb": "252, 251, 255",
      "role": "Primary light-first page canvas"
    },
    "surface-pure": {
      "value": "#FFFFFF",
      "rgb": "255, 255, 255",
      "role": "Elevated cards and containers on #FCFBFF"
    },
    "ink": {
      "value": "#171327",
      "rgb": "23, 19, 39",
      "role": "Primary wordmark, headlines, body copy (WCAG AAA 17.4:1), and dark-context canvas"
    },
    "ink-elevated": {
      "value": "#211B36",
      "rgb": "33, 27, 54",
      "role": "Elevated card surface in dark context"
    },
    "ink-border": {
      "value": "#322A4D",
      "rgb": "50, 42, 77",
      "role": "1px structural border in dark context"
    },
    "muted-ink": {
      "value": "#615B73",
      "rgb": "97, 91, 115",
      "role": "Secondary body copy, captions, metadata on light surfaces (WCAG AA 5.82:1)"
    }
  },
  "typography": {
    "display": {
      "family": "Space Grotesk",
      "fallbacks": "system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
      "license": "SIL Open Font License 1.1 (Verified open-source commercial use)",
      "weights": [
        500,
        600,
        700
      ],
      "tracking": "-0.025em",
      "line_height": 1.08
    },
    "body": {
      "family": "Inter",
      "fallbacks": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
      "license": "SIL Open Font License 1.1 (Verified open-source commercial use)",
      "weights": [
        400,
        500,
        600
      ],
      "tracking": "0em",
      "line_height": 1.6
    },
    "mono": {
      "family": "IBM Plex Mono",
      "fallbacks": "ui-monospace, 'Cascadia Code', 'Source Code Pro', monospace",
      "license": "SIL Open Font License 1.1 (Verified open-source commercial use)",
      "weights": [
        400,
        500,
        600
      ],
      "tracking": "+0.08em",
      "line_height": 1.4
    },
    "scale": {
      "hero": "56px (3.5rem)",
      "h1": "44px (2.75rem)",
      "h2": "32px (2.0rem)",
      "h3": "22px (1.375rem)",
      "body-lg": "18px (1.125rem)",
      "body": "16px (1.0rem)",
      "caption": "14px (0.875rem)",
      "mono-label": "12px (0.75rem)"
    }
  },
  "spacing": {
    "xs": "4px",
    "sm": "8px",
    "md": "16px",
    "lg": "24px",
    "xl": "32px",
    "2xl": "48px",
    "3xl": "64px",
    "4xl": "96px"
  },
  "radii": {
    "none": "0px",
    "sm": "4px",
    "md": "8px",
    "lg": "12px",
    "xl": "16px",
    "full": "9999px"
  },
  "breakpoints": {
    "mobile": "390px",
    "tablet": "768px",
    "desktop": "1280px",
    "wide": "1440px"
  }
}